<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Minimal hardened runtime entitlements for a Tauri app.
         Tauri's Rust binary + system WebView don't need JIT or unsigned
         memory. Keep it minimal to avoid codesign re-sign loops.
         (NOTE: the file is named lowercase `entitlements.plist` on disk —
         macOS FS is case-insensitive, don't add a capitalized sibling.)
         No App Group: the widget shares data through the publisher helper's
         UserDefaults (bundle-identity sharing), which works under ad-hoc
         signing where app groups are silently ignored. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>

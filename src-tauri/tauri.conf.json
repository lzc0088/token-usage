{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Usage",
  "version": "0.1.0",
  "identifier": "com.tokenusage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Token Usage",
        "width": 458,
        "height": 871,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": false
      },
      {
        "label": "settings",
        "title": "Token Usage · 设置",
        "width": 960,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Usage",
  "version": "1.0.4",
  "identifier": "com.tokenusage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "bash scripts/sign-sidecar.sh",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Token Usage",
        "width": 458,
        "height": 871,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": false,
        "devtools": false
      },
      {
        "label": "settings",
        "title": "Token Usage · 设置",
        "url": "/",
        "width": 960,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "hiddenTitle": true,
        "devtools": false
      },
      {
        "label": "floating",
        "url": "floating.html",
        "width": 44,
        "height": 44,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/tokscale*"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Ze Chuan Liu (2F74TS79TL)"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5NjY0QkEzMEVBNDREODUKUldTRlRhUU9vMHRtV2JsR2VxWVp6TER2SWs1UnhjZ3FzQ0lNOWIxR2FWV2NvQ2MxS3dPWTdJbHQK",
      "endpoints": [
        "https://github.com/lzc0088/token-usage/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
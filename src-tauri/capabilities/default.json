{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the main popover and settings windows",
  "windows": ["main", "settings", "floating"],
  "permissions": [
    "core:default",
    "shell:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "updater:default",
    "notification:default"
  ]
}

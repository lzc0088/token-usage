<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Linked into token-usage-widget-reload's __TEXT __info_plist section.
         WidgetCenter only reloads widgets owned by the containing app, so
         this helper must present the HOST app's bundle identity. -->
    <key>CFBundleIdentifier</key>
    <string>com.tokenusage.desktop</string>
    <key>CFBundleName</key>
    <string>token-usage-widget-reload</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
</dict>
</plist>

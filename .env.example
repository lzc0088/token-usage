# Copy to `.env` (gitignored) and fill in. Loaded by src-tauri/build.rs at
# compile time and Vite at frontend build time. CI provides the same values
# via repository secrets (see .github/workflows/release.yml).
#
# All are OPTIONAL for local dev — empty strings mean degraded features (no
# exchange rates, default repo in settings page).

# GitHub Release 仓库地址 — 设置页"检查更新"的默认值（Vite 编译时注入）
VITE_UPDATE_REPO=github.com/lzc0088/token-usage

# 聚合数据汇率 API key — https://www.juhe.cn/  (USD↔CNY 实时汇率)
JUHE_API_KEY=

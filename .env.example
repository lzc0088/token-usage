# Copy to `.env` (gitignored) and fill in. Loaded by src-tauri/build.rs at
# compile time and Vite at frontend build time. CI provides the same values
# via repository secrets / hardcoded env (see .github/workflows/release.yml).
#
# All are OPTIONAL for local dev — empty strings mean degraded features (no
# exchange rates, lower update-check rate limit, missing default repo in
# settings page).

# Gitee Release 仓库地址 — 设置页"检查更新"的默认值（vaite 编译时注入）
VITE_UPDATE_REPO=gitee.com/lzc0088/token-usage

# 聚合数据汇率 API key — https://www.juhe.cn/  (USD↔CNY 实时汇率)
JUHE_API_KEY=

# Gitee 私人令牌 — https://gitee.com/profile/personal_access_tokens
# 用于 app 内的"检查更新"接口提限额（匿名 ~60次/小时，带 token 更高）。
# 注意：发布用的 CI 令牌（创建/上传 Release，需 projects 权限）与这里的
# 客户端令牌可以是同一个，也可分开。CI 里对应 secret 名为 GITEE_ACCESS_TOKEN。
GITEE_TOKEN=
